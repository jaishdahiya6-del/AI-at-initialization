# Copy to .env (never commit .env). Keys stay on the backend only.
OPENWEATHER_API_KEY=YOUR_FIRST_API_KEY
OPENUV_API_KEY=YOUR_SECOND_API_KEY
MONGODB_URI=mongodb://127.0.0.1:27017/atmosphere_intelligence
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=GENERATE_A_SECURE_SECRET
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:5000/api

# Optional tuning
CACHE_TTL_SECONDS=600
COLLECT_CRON=*/30 * * * *
PREDICT_CRON=10 * * * *
MONITOR_CRON=30 3 * * *
UV_DAILY_BUDGET=45
JOBS_ENABLED=true
